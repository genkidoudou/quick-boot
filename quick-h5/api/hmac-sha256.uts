/**
 * 纯 UTS HMAC-SHA256（小写 hex），H5 / 小程序 / App 共用，无原生插件依赖。
 */

function rotr(n : number, x : number) : number {
	return ((x >>> n) | (x << (32 - n))) >>> 0
}

function ch(x : number, y : number, z : number) : number {
	return ((x & y) ^ (~x & z)) >>> 0
}

function maj(x : number, y : number, z : number) : number {
	return ((x & y) ^ (x & z) ^ (y & z)) >>> 0
}

function sigma0(x : number) : number {
	return (rotr(2, x) ^ rotr(13, x) ^ rotr(22, x)) >>> 0
}

function sigma1(x : number) : number {
	return (rotr(6, x) ^ rotr(11, x) ^ rotr(25, x)) >>> 0
}

function gamma0(x : number) : number {
	return (rotr(7, x) ^ rotr(18, x) ^ (x >>> 3)) >>> 0
}

function gamma1(x : number) : number {
	return (rotr(17, x) ^ rotr(19, x) ^ (x >>> 10)) >>> 0
}

const K : number[] = [
	0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
	0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
	0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
	0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
	0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
	0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
	0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
	0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
]

/**
 * UTF-8 编码为字节数组。
 */
export function utf8Bytes(text : string) : number[] {
	const out : number[] = []
	const n = text.length
	let i = 0
	while (i < n) {
		const c = text.charCodeAt(i)
		if (c < 0x80) {
			out.push(c)
			i++
		} else if (c < 0x800) {
			out.push(0xc0 | (c >> 6))
			out.push(0x80 | (c & 0x3f))
			i++
		} else if (c >= 0xd800 && c <= 0xdbff && i + 1 < n) {
			const c2 = text.charCodeAt(i + 1)
			if (c2 >= 0xdc00 && c2 <= 0xdfff) {
				const cp = 0x10000 + ((c - 0xd800) << 10) + (c2 - 0xdc00)
				out.push(0xf0 | (cp >> 18))
				out.push(0x80 | ((cp >> 12) & 0x3f))
				out.push(0x80 | ((cp >> 6) & 0x3f))
				out.push(0x80 | (cp & 0x3f))
				i += 2
			} else {
				out.push(0xef, 0xbf, 0xbd)
				i++
			}
		} else {
			out.push(0xe0 | (c >> 12))
			out.push(0x80 | ((c >> 6) & 0x3f))
			out.push(0x80 | (c & 0x3f))
			i++
		}
	}
	return out
}

function bytesToHex(bytes : number[]) : string {
	let s = ""
	for (let i = 0; i < bytes.length; i++) {
		const h = (bytes[i] & 0xff).toString(16)
		s += h.length == 1 ? ("0" + h) : h
	}
	return s
}

function sha256Bytes(message : number[]) : number[] {
	const bitLen = message.length * 8
	const withOne = message.slice(0)
	withOne.push(0x80)
	while ((withOne.length % 64) != 56) {
		withOne.push(0)
	}
	// 64-bit big-endian length；消息长度按实用场景只填低 32 位
	for (let i = 0; i < 4; i++) {
		withOne.push(0)
	}
	withOne.push((bitLen >>> 24) & 0xff)
	withOne.push((bitLen >>> 16) & 0xff)
	withOne.push((bitLen >>> 8) & 0xff)
	withOne.push(bitLen & 0xff)

	let h0 = 0x6a09e667
	let h1 = 0xbb67ae85
	let h2 = 0x3c6ef372
	let h3 = 0xa54ff53a
	let h4 = 0x510e527f
	let h5 = 0x9b05688c
	let h6 = 0x1f83d9ab
	let h7 = 0x5be0cd19

	const w : number[] = []
	for (let i = 0; i < 64; i++) {
		w.push(0)
	}

	for (let offset = 0; offset < withOne.length; offset += 64) {
		for (let i = 0; i < 16; i++) {
			const j = offset + i * 4
			w[i] = (((withOne[j] & 0xff) << 24) | ((withOne[j + 1] & 0xff) << 16) | ((withOne[j + 2] & 0xff) << 8) | (withOne[j + 3] & 0xff)) >>> 0
		}
		for (let i = 16; i < 64; i++) {
			w[i] = (gamma1(w[i - 2]) + w[i - 7] + gamma0(w[i - 15]) + w[i - 16]) >>> 0
		}
		let a = h0
		let b = h1
		let c = h2
		let d = h3
		let e = h4
		let f = h5
		let g = h6
		let h = h7
		for (let i = 0; i < 64; i++) {
			const t1 = (h + sigma1(e) + ch(e, f, g) + K[i] + w[i]) >>> 0
			const t2 = (sigma0(a) + maj(a, b, c)) >>> 0
			h = g
			g = f
			f = e
			e = (d + t1) >>> 0
			d = c
			c = b
			b = a
			a = (t1 + t2) >>> 0
		}
		h0 = (h0 + a) >>> 0
		h1 = (h1 + b) >>> 0
		h2 = (h2 + c) >>> 0
		h3 = (h3 + d) >>> 0
		h4 = (h4 + e) >>> 0
		h5 = (h5 + f) >>> 0
		h6 = (h6 + g) >>> 0
		h7 = (h7 + h) >>> 0
	}

	const digest : number[] = []
	const hs = [h0, h1, h2, h3, h4, h5, h6, h7]
	for (let i = 0; i < hs.length; i++) {
		const v = hs[i]
		digest.push((v >>> 24) & 0xff)
		digest.push((v >>> 16) & 0xff)
		digest.push((v >>> 8) & 0xff)
		digest.push(v & 0xff)
	}
	return digest
}

/**
 * HMAC-SHA256 → 小写 hex。
 */
export function hmacSha256Hex(keyText : string, messageText : string) : string {
	let key = utf8Bytes(keyText)
	const msg = utf8Bytes(messageText)
	if (key.length > 64) {
		key = sha256Bytes(key)
	}
	while (key.length < 64) {
		key.push(0)
	}
	const oKey : number[] = []
	const iKey : number[] = []
	for (let i = 0; i < 64; i++) {
		oKey.push(key[i] ^ 0x5c)
		iKey.push(key[i] ^ 0x36)
	}
	const inner = sha256Bytes(iKey.concat(msg))
	const outer = sha256Bytes(oKey.concat(inner))
	return bytesToHex(outer)
}

/**
 * UTF-8 字节 → Base64URL（无 padding）。
 */
export function bytesToBase64Url(bytes : number[]) : string {
	const table = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
	let out = ""
	const len = bytes.length
	let i = 0
	while (i + 2 < len) {
		const n = ((bytes[i] & 0xff) << 16) | ((bytes[i + 1] & 0xff) << 8) | (bytes[i + 2] & 0xff)
		out += table.charAt((n >>> 18) & 63)
		out += table.charAt((n >>> 12) & 63)
		out += table.charAt((n >>> 6) & 63)
		out += table.charAt(n & 63)
		i += 3
	}
	const rem = len - i
	if (rem == 1) {
		const n = (bytes[i] & 0xff) << 16
		out += table.charAt((n >>> 18) & 63)
		out += table.charAt((n >>> 12) & 63)
	} else if (rem == 2) {
		const n = ((bytes[i] & 0xff) << 16) | ((bytes[i + 1] & 0xff) << 8)
		out += table.charAt((n >>> 18) & 63)
		out += table.charAt((n >>> 12) & 63)
		out += table.charAt((n >>> 6) & 63)
	}
	return out
}

/**
 * 文本 → Base64URL（无 padding）。
 */
export function textToBase64Url(text : string) : string {
	return bytesToBase64Url(utf8Bytes(text))
}
