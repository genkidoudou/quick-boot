/**
 * quick-h5 运行时配置。
 * 用 NODE_ENV 区分开发/发行（运行=development，发行=production），H5/小程序/App 均支持。
 * 开发直连本机网关；真机联调请把 DEV_API_BASE 改成电脑局域网 IP。
 * 生产：H5 默认同域 /prod-api（需 Nginx 反代）；小程序/App 用绝对域名（须配置合法 request 域名）。
 * 联调注意：仓库后端当前未见 /sendSms、/phoneLogin，手机登录联调可能 404（验收 PENDING）。
 */

/** 开发态 API 根地址（H5 可用 127.0.0.1；真机请改为局域网 IP） */
const DEV_API_BASE : string = "http://127.0.0.1:9993"

// #ifdef WEB
/** H5 发行：与 Nginx location /prod-api/ 对齐的同域前缀 */
const PROD_API_BASE : string = "/prod-api"
// #endif
// #ifndef WEB
/** 小程序 / App 发行：正式 API 根地址（占位，上线前替换） */
const PROD_API_BASE : string = "https://api.example.com"
// #endif

/**
 * 当前编译环境下的 API 根地址。
 */
export const API_BASE : string = process.env.NODE_ENV == "development" ? DEV_API_BASE : PROD_API_BASE

/** 登录页品牌标题 */
export const APP_TITLE : string = "QuickBoot"

/** token 本地存储键 */
export const TOKEN_KEY : string = "qb_access_token"


export const SIGN_CLIENT_ID : string = "app"


export const SIGN_CLIENT_SECRET : string = "dbb43fe9b1eb4ff29eaed631009b6d1f"
