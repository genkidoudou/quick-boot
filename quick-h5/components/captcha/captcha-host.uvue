<template>
	<!-- H5 / WEB 走 TAC；其它端走原生滑块 -->
	<!-- #ifdef H5 || WEB -->
	<captcha-h5></captcha-h5>
	<!-- #endif -->
	<!-- #ifndef H5 -->
	<!-- #ifndef WEB -->
	<captcha-native></captcha-native>
	<!-- #endif -->
	<!-- #endif -->
</template>

<script setup lang="uts">
	/**
	 * 多端验证码入口：H5 走官方 TAC，其它端走原生滑块。
	 * 打开方式：子组件 onMounted 注册到 bridge.uts，页面调 openCaptcha()。
	 * 子组件同目录，autoscan 扫不到，需显式 import。
	 */
	// #ifdef H5 || WEB
	import CaptchaH5 from "@/components/captcha/captcha-h5.uvue"
	// #endif
	// #ifndef H5
	// #ifndef WEB
	import CaptchaNative from "@/components/captcha/captcha-native.uvue"
	// #endif
	// #endif

	defineOptions({ name: "CaptchaHost" })
</script>
