		flex: 1;
		min-width: 0;
		padding: 4px;
		border-radius: 14px;
		background-color: rgba(255, 255, 255, 0.7);
		border-width: 1px;
		border-style: solid;
		border-color: rgba(24, 24, 27, 0.05);
	}
	.c7-json-table__chip {
		font-size: 12px;
		font-weight: 600;
		padding: 7px 12px;
		border-radius: 10px;
		margin-right: 2px;
		color: #71717a;
	}
	.c7-json-table__chip.is-on {
		color: #5b21b6;
		background-color: #ffffff;
		/* #ifdef WEB */
		box-shadow: 0 2px 8px rgba(88, 70, 140, 0.10);
		/* #endif */
	}
	.c7-json-table__add {
		margin-left: 10px;
		padding: 8px 14px;
		border-radius: 999px;
		background-color: #8d51f9;
		flex-shrink: 0;
	}
	.c7-json-table__add-t {
		font-size: 13px;
		font-weight: 600;
		color: #ffffff;
	}
	.c7-json-table__meta {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin-bottom: 10px;
		padding-left: 2px;
	}
	.c7-json-table__count {
		font-size: 12px;
		color: #8b8796;
	}
	.c7-json-table__card {
		display: flex;
		flex-direction: row;
		align-items: stretch;
		background-color: #ffffff;
		border-radius: 20px;
		border-width: 1px;
		border-style: solid;
		border-color: rgba(24, 24, 27, 0.05);
		overflow: hidden;
		/* #ifdef WEB */
		box-shadow: 0 10px 28px rgba(70, 55, 110, 0.06);
