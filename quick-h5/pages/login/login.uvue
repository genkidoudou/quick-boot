<template>
	<view class="page">
		<view class="glow glow-a"></view>
		<view class="glow glow-b"></view>
		<view class="shell">
			<view class="brand">
				<text class="brand-title">{{ appTitle }}</text>
				<text class="brand-sub">欢迎登录</text>
			</view>
			<view class="card">
				<rice-subsection :list="tabList" shape="round" :init-animate="false" @change="onTabChange"></rice-subsection>
				<view class="form">
					<template v-if="tabIndex == 0">
						<rice-input v-model="username" placeholder="用户名" clearable shape="round"></rice-input>
						<view class="field-gap"></view>
						<rice-input v-model="password" type="password" show-password placeholder="密码" clearable shape="round"></rice-input>
					</template>
					<template v-else>
						<rice-input v-model="phone" type="number" maxlength="11" placeholder="手机号" clearable shape="round"></rice-input>
						<view class="field-gap"></view>
						<view class="sms-row">
							<view class="sms-input">
								<rice-input v-model="smsCode" type="number" maxlength="6" placeholder="验证码" clearable shape="round"></rice-input>
							</view>
							<rice-button
								size="small"
								type="info"
								:text="smsBtnText"
								:disabled="smsCounting || loginLoading"
								@click="onSendSms"
							></rice-button>
						</view>
					</template>
					<view class="field-gap"></view>
					<rice-button
						type="primary"
						:text="loginLoading ? '登录中…' : '登录'"
						:loading="loginLoading"
						:disabled="loginLoading"
						width="100%"
						shape="round"
						@click="onLogin"
					></rice-button>
				</view>
			</view>
		</view>
		<captcha-host></captcha-host>
	</view>
</template>

<script setup lang="uts">
	import { APP_TITLE } from "@/config/env"
	import { loginByPassword, loginByPhone, sendSmsCode, fetchUserInfo } from "@/api/login"
	import { fetchCaptchaEnabled } from "@/api/captcha"
	import { openCaptcha as openCaptchaBridge } from "@/components/captcha/bridge.uts"
	import { setToken } from "@/store/user"
	// captcha 在 components/captcha/ 下，autoscan 扫不到，显式注册
	import CaptchaHost from "@/components/captcha/captcha-host.uvue"

	const appTitle = APP_TITLE
	const tabList = ["账号登录", "手机登录"]
	const tabIndex = ref(0)
	const username = ref("")
	const password = ref("")
	const phone = ref("")
	const smsCode = ref("")
	const loginLoading = ref(false)
	const smsCounting = ref(false)
	const smsLeft = ref(0)
	let smsTimer : number = 0

	const smsBtnText = computed(() : string => {
		if (smsCounting.value && smsLeft.value > 0) {
			return `${smsLeft.value}s`
		}
		return "获取验证码"
	})

	function onTabChange(index : number) {
		tabIndex.value = index
	}

	function toast(msg : string) {
		uni.showToast({ title: msg, icon: "none" })
	}

	function goHome() {
		uni.reLaunch({ url: "/pages/index/index" })
	}

	function afterLogin(token : string) {
		setToken(token)
		fetchUserInfo().then((_info) => {
			loginLoading.value = false
			goHome()
		}).catch((_e) => {
			// 权限拉取失败仍进入首页，按钮会按无权限隐藏
			loginLoading.value = false
			goHome()
		})
	}

	/** 经 bridge 打开（不依赖 template ref / defineExpose） */
	function openCaptcha() : Promise<string> {
		return openCaptchaBridge()
	}

	function clearSmsTimer() {
		if (smsTimer != 0) {
			clearInterval(smsTimer)
			smsTimer = 0
		}
	}

	function startSmsCountdown() {
		clearSmsTimer()
		smsCounting.value = true
		smsLeft.value = 60
		smsTimer = setInterval(() => {
			const next = smsLeft.value - 1
			smsLeft.value = next
			if (next <= 0) {
				clearSmsTimer()
				smsCounting.value = false
				smsLeft.value = 0
			}
		}, 1000) as number
	}

	function onSendSms() {
		const p = phone.value.trim()
		if (!/^1\d{10}$/.test(p)) {
			toast("请输入正确手机号")
			return
		}
		if (smsCounting.value || loginLoading.value) {
			return
		}
		sendSmsCode(p).then(() => {
			toast("验证码已发送")
			startSmsCountdown()
		}).catch((err) => {
			const msg = `${err}`
			if (msg.indexOf("404") >= 0 || msg.indexOf("Not Found") >= 0 || msg.indexOf("不存在") >= 0) {
				toast("短信服务暂不可用")
			}
		})
	}

	function doPasswordLogin(uuid : string | null) {
		loginLoading.value = true
		loginByPassword(username.value.trim(), password.value, uuid).then((token) => {
			afterLogin(token)
		}).catch((_e) => {
			loginLoading.value = false
		})
	}

	function onAccountLogin() {
		if (username.value.trim().length == 0) {
			toast("请输入用户名")
			return
		}
		if (password.value.length == 0) {
			toast("请输入密码")
			return
		}
		if (loginLoading.value) {
			return
		}
		loginLoading.value = true
		fetchCaptchaEnabled().then((enabled) => {
			if (!enabled) {
				loginLoading.value = false
				doPasswordLogin(null)
				return
			}
			loginLoading.value = false
			openCaptcha().then((uuid) => {
				doPasswordLogin(uuid)
			}).catch((err) => {
				const msg = `${err}`
				if (msg.length > 0 && msg != "已取消验证") {
					toast(msg)
				}
			})
		}).catch((_e) => {
			loginLoading.value = false
		})
	}

	function onPhoneLogin() {
		const p = phone.value.trim()
		const code = smsCode.value.trim()
		if (!/^1\d{10}$/.test(p)) {
			toast("请输入正确手机号")
			return
		}
		if (code.length == 0) {
			toast("请输入验证码")
			return
		}
		if (loginLoading.value) {
			return
		}
		loginLoading.value = true
		loginByPhone(p, code).then((token) => {
			afterLogin(token)
		}).catch((err) => {
			loginLoading.value = false
			const msg = `${err}`
			if (msg.indexOf("404") >= 0 || msg.indexOf("Not Found") >= 0 || msg.indexOf("不存在") >= 0) {
				toast("短信服务暂不可用")
			}
		})
	}

	function onLogin() {
		if (tabIndex.value == 0) {
			onAccountLogin()
		} else {
			onPhoneLogin()
		}
	}

	onUnload(() => {
		clearSmsTimer()
	})
</script>

<style>
	.page {
		display: flex;
		flex-direction: column;
		/* #ifndef APP */
		min-height: 100vh;
		/* #endif */
		/* #ifdef APP */
		flex: 1;
		/* #endif */
		background-color: var(--rice-background);
		position: relative;
		overflow: hidden;
	}
	.glow {
		position: absolute;
		border-radius: 9999px;
		opacity: 0.35;
	}
	.glow-a {
		width: 220px;
		height: 220px;
		left: -60px;
		top: -40px;
		background-color: #8D51F9;
	}
	.glow-b {
		width: 180px;
		height: 180px;
		right: -50px;
		top: 120px;
		background-color: #7C9CFF;
	}
	.shell {
		position: relative;
		z-index: 1;
		padding: 72px 24px 24px;
		display: flex;
		flex-direction: column;
	}
	.brand {
		margin-bottom: 28px;
		display: flex;
		flex-direction: column;
	}
	.brand-title {
		font-size: 32px;
		font-weight: 700;
		color: var(--rice-text-color);
		margin-bottom: 8px;
	}
	.brand-sub {
		font-size: 15px;
		color: var(--rice-text-color-2, #666666);
	}
	.card {
		padding: 20px 16px 24px;
		border-radius: 20px;
		background-color: var(--rice-background-2, rgba(255, 255, 255, 0.82));
		border-width: 1px;
		border-style: solid;
		border-color: var(--rice-border-color, rgba(141, 81, 249, 0.18));
		display: flex;
		flex-direction: column;
	}
	.form {
		margin-top: 20px;
		display: flex;
		flex-direction: column;
	}
	.field-gap {
		height: 14px;
	}
	.sms-row {
		display: flex;
		flex-direction: row;
		align-items: center;
	}
	.sms-input {
		flex: 1;
		margin-right: 10px;
	}
</style>
