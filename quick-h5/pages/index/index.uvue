		color: var(--rice-text-color-2, #666666);
		margin-bottom: 8px;
	}
	.ops-title {
		color: #f8fafc;
	}
	.ops-desc {
		color: rgba(248, 250, 252, 0.75);
		margin-bottom: 0;
	}
	.badge {
		align-self: flex-start;
		font-size: 11px;
		font-weight: 600;
		padding: 2px 8px;
		border-radius: 999px;
	}
	.badge-warn {
		background-color: rgba(217, 119, 6, 0.12);
		color: #d97706;
	}
	.feed-card {
		border-radius: 16px;
		background-color: var(--rice-background-2, #ffffff);
		border-width: 1px;
		border-style: solid;
		border-color: rgba(24, 24, 27, 0.08);
		padding: 4px 14px;
	}
	.feed-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 12px 0;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: rgba(24, 24, 27, 0.06);
	}
	.feed-row-last {
		border-bottom-width: 0;
	}
	.feed-empty {
		border-radius: 16px;
		background-color: var(--rice-background-2, #ffffff);
		border-width: 1px;
