<template>
	<view class="page">
		<view class="content">
			<view class="hero">
				<view class="hero-top">
					<text class="hero-ey">{{ heroEyebrow }}</text>
					<c7-inbox-bell :count="unreadCount" tone="light"></c7-inbox-bell>
				</view>
				<text class="hero-title">你好，{{ displayName }}</text>
				<text class="hero-sub">从待办与常用入口开始，而不是从一张空表格开始。</text>
			</view>

			<text class="sec">今日关注</text>
			<view class="attn-grid">
				<view class="attn-card" @click="goJobLog">
					<text class="attn-title">定时任务</text>
					<text class="attn-desc">{{ jobDesc }}</text>
					<text class="badge badge-warn">运维</text>
				</view>
				<view class="attn-card attn-ops" @click="onOpsClick">
					<text class="attn-title ops-title">运行状态</text>
					<text class="attn-desc ops-desc">登录日志 · 操作审计</text>
				</view>
			</view>

			<view class="sec-h">
				<text class="sec">最近消息</text>
				<text class="sec-more" @click="goInbox">全部</text>
			</view>
			<view class="feed-card" v-if="feedList.length > 0">
				<view
					class="feed-row"
					v-for="(item, idx) in feedList"
					:key="item.id"
					:class="idx == feedList.length - 1 ? 'feed-row-last' : ''"
					@click="goFeed(item)"
				>
					<view class="av" :class="item.unread ? '' : 'av-muted'">
						<view class="av-dot" v-if="item.unread"></view>
						<text class="av-t">信</text>
					</view>
					<view class="feed-body">
						<text class="feed-title" :class="item.unread ? 'is-unread' : ''">{{ item.title }}</text>
						<text class="feed-sub">{{ item.sub }}</text>
					</view>
					<text class="feed-time">{{ item.time }}</text>
				</view>
			</view>
			<view class="feed-empty" v-else>
				<text class="feed-empty-t">{{ feedEmptyText }}</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	/**
	 * 首页：问候 + 铃铛未读 + 运维关注 + 最近消息预览。
	 */
	import { getUserProfile } from "@/api/system/user"
	import {
		unreadInboxCount,
		pageMineInbox,
		InboxPayload
	} from "@/api/msg/inbox"
	import { pageJobLog } from "@/api/job/jobLog"

	type FeedItem = {
		id : string
		title : string
		sub : string
		time : string
		unread : boolean
	}

	const displayName = ref("…")
	const heroEyebrow = ref("今天 · 产品工作台")
	const unreadCount = ref(0)
	const jobFailCount = ref(0)
	const feedList = ref<FeedItem[]>([] as FeedItem[])
	const loading = ref(false)
	const feedEmptyText = ref("加载中…")

	const jobDesc = computed(() : string => {
		const n = jobFailCount.value
		if (n <= 0) {
			return "近期无失败"
		}
		return `${n} 个失败`
	})

	function formatEyebrow() : string {
		const d = new Date()
		const m = d.getMonth() + 1
		const day = d.getDate()
		return `${m}月${day}日 · 产品工作台`
	}

	function shortTime(raw : string) : string {
		const t = raw.trim()
		if (t.length == 0) {
			return ""
		}
		if (t.length >= 16) {
			return t.substring(5, 16)
		}
		if (t.length > 10) {
			return t.substring(0, 10)
		}
		return t
	}

	function mapFeed(row : InboxPayload) : FeedItem {
		const unread = row.readFlag != "1"
		let sub = row.content.trim()
		if (sub.length > 36) {
			sub = sub.substring(0, 36) + "…"
		}
		if (sub.length == 0) {
			sub = unread ? "未读消息" : "已读消息"
		}
		return {
			id: row.id,
			title: row.title.length > 0 ? row.title : "系统通知",
			sub: sub,
			time: shortTime(row.createTime),
			unread: unread
		} as FeedItem
	}

	function loadHome() : Promise<void> {
		if (loading.value) {
			return Promise.resolve()
		}
		loading.value = true
		heroEyebrow.value = formatEyebrow()

		const pProfile = getUserProfile().then((u) => {
			let name = u.nickName.trim()
			if (name.length == 0) {
				name = u.userName.trim()
			}
			displayName.value = name.length > 0 ? name : "用户"
		}).catch((_e) => {
			if (displayName.value == "…") {
				displayName.value = "用户"
			}
		})

		const pUnread = unreadInboxCount().then((n) => {
			unreadCount.value = n
		}).catch((_e) => {
			unreadCount.value = 0
		})

		const jobQuery = {
			current: 1,
			size: 1,
			param: { status: "2" } as UTSJSONObject
		}
		const pJob = pageJobLog(jobQuery).then((res) => {
			jobFailCount.value = res.total
		}).catch((_e) => {
			jobFailCount.value = 0
		})

		const inboxQuery = {
			current: 1,
			size: 5,
			param: {} as UTSJSONObject
		}
		const pFeed = pageMineInbox(inboxQuery).then((res) => {
			const rows = res.records
			const out : FeedItem[] = [] as FeedItem[]
			if (rows != null) {
				const len = rows.length
				for (let i = 0; i < len; i++) {
					const row = rows[i] as InboxPayload
					if (row != null && row.id.length > 0) {
						out.push(mapFeed(row))
					}
				}
			}
			feedList.value = out
			feedEmptyText.value = "暂时没有消息"
		}).catch((_e) => {
			feedList.value = [] as FeedItem[]
			feedEmptyText.value = "消息加载失败"
		})

		return Promise.all([pProfile, pUnread, pJob, pFeed] as any[]).then((_arr) : void => {
			loading.value = false
			uni.stopPullDownRefresh()
		}).catch((_e) : void => {
			loading.value = false
			uni.stopPullDownRefresh()
		})
	}

	function goInbox() {
		uni.navigateTo({ url: "/pages/msg/inbox/index" })
	}

	function goJobLog() {
		uni.navigateTo({ url: "/pages/job/jobLog/index" })
	}

	function goLogininfor() {
		uni.navigateTo({ url: "/pages/system/logininfor/index" })
	}

	function goOperLog() {
		uni.navigateTo({ url: "/pages/system/operLog/index" })
	}

	function onOpsClick() {
		uni.showActionSheet({
			itemList: ["登录日志", "操作日志"],
			success: (res) => {
				if (res.tapIndex == 0) {
					goLogininfor()
				} else if (res.tapIndex == 1) {
					goOperLog()
				}
			}
		})
	}

	function goFeed(item : FeedItem) {
		if (item.id.length == 0) {
			return
		}
		uni.navigateTo({ url: "/pages/msg/inbox/detail?id=" + encodeURIComponent(item.id) })
	}

	onShow(() => {
		loadHome()
	})

	onPullDownRefresh(() => {
		loadHome()
	})
</script>

<style>
