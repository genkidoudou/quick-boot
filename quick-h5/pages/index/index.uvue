		color: var(--rice-text-color-2, #666666);
		margin: 0;
	}
	.sec-more {
		font-size: 12px;
		color: #8d51f9;
		font-weight: 600;
	}
	.attn-grid {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		margin-bottom: 8px;
	}
	.attn-card {
		width: 48%;
		margin-right: 4%;
		margin-bottom: 10px;
		padding: 14px;
		border-radius: 16px;
		background-color: var(--rice-background-2, #ffffff);
		border-width: 1px;
		border-style: solid;
		border-color: rgba(24, 24, 27, 0.08);
		display: flex;
		flex-direction: column;
	}
	.attn-ops {
		width: 48%;
		margin-right: 0;
		background-image: linear-gradient(135deg, #2a1f4a, #0b1322);
		border-width: 0;
	}
	.attn-title {
		font-size: 14px;
		font-weight: 600;
		color: var(--rice-text-color);
		margin-bottom: 4px;
	}
	.attn-desc {
