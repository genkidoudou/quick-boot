				</c7-card>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	const statusOpts = ref([
		{ label: "启用", value: "1", elTagType: "success" } as UTSJSONObject,
		{ label: "停用", value: "0", elTagType: "info" } as UTSJSONObject
	] as any[])

	const detail = ref({
		name: "QuickBoot",
		status: "1",
		url: "https://example.com",
		remark: "Soft Glass H5"
	} as UTSJSONObject)

	const descItems = ref([
		{ label: "名称", prop: "name" } as UTSJSONObject,
		{ label: "状态", prop: "status", columnType: "tag", options: statusOpts.value } as UTSJSONObject,
		{ label: "链接", prop: "url", columnType: "link" } as UTSJSONObject,
		{ label: "备注", prop: "remark", columnType: "copy" } as UTSJSONObject
	] as any[])

	const colItems = ref([
		{ label: "名称", prop: "name" } as UTSJSONObject,
		{ label: "状态", prop: "status", columnType: "tag", options: statusOpts.value } as UTSJSONObject
	] as any[])

	const page = ref(1)
	const pageSize = ref(10)

	function onPage(p : number, s : number) {
		console.log("page", p, s)
	}
</script>

