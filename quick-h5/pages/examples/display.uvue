<template>
	<view class="page">
		<scroll-view scroll-y class="scroll">
			<view class="content">
				<c7-title label="展示组件" label-size="h3"></c7-title>

				<c7-card label="可折叠卡片" :collapsible="true" :show-color-block="true" :is-bold="true">
					<template #extra>
						<c7-copy text="QuickBoot-H5" mode="text" button-text="复制"></c7-copy>
					</template>
					<text class="body-t">C7Card + C7Copy 示例内容。</text>
				</c7-card>

				<c7-descriptions :data="detail" :items="descItems"></c7-descriptions>

				<c7-card label="C7DictTag" :show-color-block="true">
					<c7-dict-tag value="1" :options="statusOpts"></c7-dict-tag>
				</c7-card>

				<c7-card label="C7JsonTableColumn" :show-color-block="true">
					<c7-json-table-column :row="detail" :columns="colItems"></c7-json-table-column>
				</c7-card>

				<c7-card label="C7Pagination" :show-color-block="true">
					<c7-pagination
						v-model:current-page="page"
