<template>
	<view class="page">
		<view class="content">
			<c7-title label="C7 Packages 示例" label-size="h3"></c7-title>
			<text class="sub">对齐 quick-ui packages 命名与常用 props，基于 RiceUI。</text>

			<view class="group">
				<template v-for="(item, idx) in menus" :key="idx">
					<view class="line" @click="go(item.path)">
						<text class="line-l">{{ item.label }}</text>
						<text class="line-r">›</text>
					</view>
				</template>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	type MenuItem = {
		label : string
		path : string
	}

	const menus = ref([
		{ label: "表单控件", path: "/pages/examples/form" } as MenuItem,
		{ label: "展示组件", path: "/pages/examples/display" } as MenuItem,
		{ label: "弹层与反馈", path: "/pages/examples/feedback" } as MenuItem,
		{ label: "其它组件", path: "/pages/examples/misc" } as MenuItem,
		{ label: "关于 QuickBoot", path: "/pages/examples/about" } as MenuItem
	] as MenuItem[])

	function go(path : string) {
		uni.navigateTo({ url: path })
	}
</script>

