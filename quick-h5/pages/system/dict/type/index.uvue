<template>
	<!-- Soft Glass 列表视觉由 C7JsonTable 内置；本页只配业务 props -->
	<view class="page">
		<c7-json-table
			ref="tableRef"
			:list-function="pageDictType"
			:delete-function="removeDictType"
			:table-columns="tableColumns"
			:search-columns="searchColumns"
			row-key="id"
			:show-add-button="true"
			:add-button-permi="['system:dictType:add']"
			:edit-button-permi="['system:dictType:edit']"
			:delete-button-permi="['system:dictType:remove']"
			delete-label-prop="dictName"
			add-path="/pages/system/dict/type/form"
			@row-click="onRowClick"
		></c7-json-table>
	</view>
</template>

<script setup lang="uts">
	/**
	 * 字典类型列表（quick-h5）
	 *
	 * 对齐 quick-ui：pageDictType / removeDictType。
	 * 行点击进入字典数据列表（?dictType=）；编辑走动作面板。
	 */
	import {
		pageDictType,
		removeDictType,
		DictTypePayload
	} from "@/api/system/dict/type"
	import { bindC7TablePage } from "@/components/c7-json-table/table-page.uts"

	const tableRef = ref<ComponentPublicInstance | null>(null)

	const tableColumns = [
		{
			layout: "row",
			children: [
				{ prop: "dictName", hideLabel: true, emphasize: true } as UTSJSONObject,
				{ prop: "status", hideLabel: true, columnType: "tag", dictType: "COMMON_STATUS" } as UTSJSONObject
			] as any[]
		} as UTSJSONObject,
		{ prop: "dictType", label: "字典类型" } as UTSJSONObject,
		{ prop: "remark", label: "备注", emptyText: "—" } as UTSJSONObject
	] as any[]

	const searchColumns = [
		{ prop: "dictName", label: "字典名称", type: "input" } as UTSJSONObject,
		{ prop: "dictType", label: "字典类型", type: "input" } as UTSJSONObject,
		{ prop: "status", label: "状态", type: "select", dictType: "COMMON_STATUS" } as UTSJSONObject
	] as any[]

	bindC7TablePage(() : any | null => {
		return tableRef.value
	})

	function goData(dictType : string) {
		uni.navigateTo({
			url: "/pages/system/dict/data/index?dictType=" + encodeURIComponent(dictType)
		})
	}

	function goEdit(id : string) {
		uni.navigateTo({ url: "/pages/system/dict/type/form?id=" + encodeURIComponent(id) })
	}

	/** 行点击：选「字典数据」或「编辑」 */
	function onRowClick(row : any) {
		const payload = row as DictTypePayload
		if (payload.id.length == 0) {
			return
		}
		uni.showActionSheet({
			itemList: ["字典数据", "编辑"],
			success: (res) => {
				if (res.tapIndex == 0) {
					if (payload.dictType.length > 0) {
						goData(payload.dictType)
					}
					return
				}
				if (res.tapIndex == 1) {
					goEdit(payload.id)
				}
			}
		})
	}
</script>

<style>
	.page {
		display: flex;
		flex-direction: column;
		/* #ifndef APP */
		min-height: 100vh;
		/* #endif */
		/* #ifdef APP */
		flex: 1;
		/* #endif */
	}
</style>
