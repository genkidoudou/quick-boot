<template>
	<c7-form-page
		:saving="saving"
		:loading="loading"
		:is-edit="isEdit"
		add-title="新增菜单"
		edit-title="修改菜单"
		:show-delete="isEdit"
		:add-button-permi="['system:menu:add']"
		:edit-button-permi="['system:menu:edit']"
		:delete-button-permi="['system:menu:remove']"
		@save="onSave"
		@delete="onRemove"
	>
		<rice-form
			:key="formKey"
			ref="formRef"
			:model="form"
			:rules="formRules"
			label-position="top"
			:show-required="true"
			required-position="left"
			:border-bottom="false"
			:show-error="true"
		>
			<rice-form-item name="parentId" label="上级菜单" required>
				<c7-tree-select
					v-model="form['parentId']"
					:options="parentTreeOpts"
					label-key="menuName"
					value-key="id"
					children-key="children"
					placeholder="请选择上级菜单"
					title="选择上级菜单"
				></c7-tree-select>
			</rice-form-item>

			<rice-form-item name="menuName" label="菜单名称" required>
				<rice-input
					v-model="form['menuName']"
					placeholder="请输入名称"
					clearable
					:maxlength="255"
					border="none"
				></rice-input>
			</rice-form-item>

			<rice-form-item name="menuType" label="菜单类型" required>
				<rice-radio-group v-model="form['menuType']" direction="row">
					<rice-radio label="目录" value="M"></rice-radio>
					<rice-radio label="菜单" value="C"></rice-radio>
					<rice-radio label="按钮" value="F"></rice-radio>
				</rice-radio-group>
			</rice-form-item>

			<rice-form-item v-if="form['menuType'] != 'F'" name="path" label="路由地址">
				<rice-input
					v-model="form['path']"
					placeholder="如 system/user"
					clearable
					:maxlength="255"
					border="none"
				></rice-input>
			</rice-form-item>

			<rice-form-item v-if="form['menuType'] != 'F'" name="component" label="组件路径">
				<rice-input
					v-model="form['component']"
					placeholder="如 system/user/index；目录可留空为 Layout"
					clearable
					:maxlength="255"
					border="none"
				></rice-input>
			</rice-form-item>

			<rice-form-item v-if="form['menuType'] != 'F'" name="routeName" label="路由名称">
				<rice-input
					v-model="form['routeName']"
					placeholder="如 SysUser"
					clearable
					:maxlength="100"
					border="none"
				></rice-input>
			</rice-form-item>

			<rice-form-item v-if="form['menuType'] == 'C'" name="query" label="路由参数">
				<rice-input
					v-model="form['query']"
					placeholder='如 {"id":1}'
					clearable
					:maxlength="255"
					border="none"
				></rice-input>
			</rice-form-item>

			<rice-form-item v-if="form['menuType'] != 'F'" name="icon" label="菜单图标">
				<rice-input
					v-model="form['icon']"
					placeholder="SVG 图标名，如 user"
					clearable
					:maxlength="100"
					border="none"
				></rice-input>
			</rice-form-item>

			<rice-form-item name="perms" label="权限字符">
				<rice-input
					v-model="form['perms']"
					placeholder="如 system:user:list"
					clearable
					:maxlength="255"
					border="none"
				></rice-input>
			</rice-form-item>

			<rice-form-item name="orderNum" label="显示排序" required>
				<rice-input
					v-model="form['orderNum']"
					placeholder="数字"
					clearable
					:maxlength="8"
					border="none"
				></rice-input>
			</rice-form-item>

			<rice-form-item v-if="form['menuType'] != 'F'" name="isFrame" label="是否外链">
				<rice-radio-group v-model="form['isFrame']" direction="row">
					<rice-radio label="否" value="0"></rice-radio>
					<rice-radio label="是" value="1"></rice-radio>
				</rice-radio-group>
			</rice-form-item>

			<rice-form-item v-if="form['menuType'] != 'F'" name="isCache" label="是否缓存">
				<rice-radio-group v-model="form['isCache']" direction="row">
					<rice-radio label="缓存" value="0"></rice-radio>
					<rice-radio label="不缓存" value="1"></rice-radio>
				</rice-radio-group>
			</rice-form-item>

			<rice-form-item name="visible" label="显示状态">
				<rice-radio-group v-model="form['visible']" direction="row">
					<rice-radio label="显示" value="0"></rice-radio>
					<rice-radio label="隐藏" value="1"></rice-radio>
				</rice-radio-group>
			</rice-form-item>

			<rice-form-item name="status" label="状态" required>
				<rice-radio-group v-model="form['status']" direction="row">
					<rice-radio label="正常" value="0"></rice-radio>
					<rice-radio label="停用" value="1"></rice-radio>
				</rice-radio-group>
			</rice-form-item>
		</rice-form>
	</c7-form-page>
</template>

<script setup lang="uts">
	import { showDialog, FormRules } from "@/uni_modules/rice-ui"
	import { callRiceFormValidate } from "@/utils/rice-form"
	import {
		getMenu,
		addMenu,
		updateMenu,
		removeMenu,
		treeselectMenu,
		MenuPayload
	} from "@/api/system/menu"

	type MenuFormModel = {
		parentId : string
		menuName : string
		menuType : string
		path : string
		routeName : string
		component : string
		perms : string
		icon : string
		orderNum : string
		query : string
		isFrame : string
		isCache : string
		status : string
		visible : string
	}

	const id = ref("")
	const form = ref({
		parentId: "0",
		menuName: "",
		menuType: "C",
		path: "",
		routeName: "",
		component: "",
		perms: "",
		icon: "",
		orderNum: "0",
		query: "",
		isFrame: "0",
		isCache: "0",
		status: "0",
		visible: "0"
	} as MenuFormModel)

	const parentTreeOpts = ref([] as any[])

	const formRules = new Map<string, FormRules[]>([
		["parentId", [{ required: true, message: "上级菜单不能为空", trigger: "change" } as FormRules]],
		["menuName", [{ required: true, message: "菜单名称不能为空", trigger: "blur" } as FormRules]],
		["menuType", [{ required: true, message: "菜单类型不能为空", trigger: "change" } as FormRules]],
		["orderNum", [{ required: true, message: "排序不能为空", trigger: "blur" } as FormRules]],
		["status", [{ required: true, message: "状态不能为空", trigger: "change" } as FormRules]]
	])

	const formRef = ref<ComponentPublicInstance | null>(null)
	const formKey = ref(0)
	const loading = ref(false)
	const saving = ref(false)
	const detailLoaded = ref(false)

	const isEdit = computed(() : boolean => {
		return id.value.length > 0
	})

	function applyForm(row : MenuPayload) {
		form.value = {
			parentId: row.parentId.length > 0 ? row.parentId : "0",
			menuName: row.menuName,
			menuType: row.menuType.length > 0 ? row.menuType : "C",
			path: row.path,
			routeName: row.routeName,
			component: row.component,
			perms: row.perms,
			icon: row.icon,
			orderNum: row.orderNum.length > 0 ? row.orderNum : "0",
			query: row.query,
			isFrame: row.isFrame.length > 0 ? row.isFrame : "0",
			isCache: row.isCache.length > 0 ? row.isCache : "0",
			status: row.status.length > 0 ? row.status : "0",
			visible: row.visible.length > 0 ? row.visible : "0"
		} as MenuFormModel
		formKey.value = formKey.value + 1
	}

	function loadDetail() {
		if (id.value.length == 0 || loading.value) {
			return
		}
		loading.value = true
		getMenu(id.value).then((row) => {
			applyForm(row)
			detailLoaded.value = true
			loading.value = false
		}).catch((_e) => {
			loading.value = false
			uni.showToast({ title: "加载详情失败", icon: "none" })
		})
	}

	/** 排除自身及子孙，避免把菜单挂到自己下面 */
	function excludeSelfAndDescendants(nodes : any[], selfId : string) : any[] {
		if (selfId.length == 0) {
			return nodes
		}
		const out : any[] = []
		for (let i = 0; i < nodes.length; i++) {
			const row = nodes[i]
			if (row == null) {
				continue
			}
			const o = row as UTSJSONObject
			const nid = o["id"] != null ? `${o["id"]}` : (o["menuId"] != null ? `${o["menuId"]}` : "")
			if (nid == selfId) {
				continue
			}
			const kids = o["children"]
			let nextKids : any[] = []
			if (kids != null && Array.isArray(kids)) {
				nextKids = excludeSelfAndDescendants(kids as any[], selfId)
			}
			const copy = JSON.parseObject(JSON.stringify(o)!)
			if (copy != null) {
				copy["children"] = nextKids
				out.push(copy)
			}
		}
		return out
	}

	function loadParentTree(excludeId : string) {
		treeselectMenu().then((tree) => {
			const root = {
				id: "0",
				menuName: "顶级菜单",
				children: excludeSelfAndDescendants(tree, excludeId)
			} as UTSJSONObject
			parentTreeOpts.value = [root] as any[]
		}).catch((_e) => {})
	}

	onLoad((query) => {
		let excludeId = ""
		if (query != null) {
			const qid = query["id"]
			if (qid != null && `${qid}`.length > 0) {
				id.value = `${qid}`
				excludeId = id.value
				loadDetail()
			}
		}
		loadParentTree(excludeId)
	})

	onShow(() => {
		if (isEdit.value && !detailLoaded.value && !loading.value) {
			loadDetail()
		}
	})

	function buildPayload() : MenuPayload {
		const f = form.value
		return {
			id: id.value,
			parentId: f.parentId.trim().length > 0 ? f.parentId.trim() : "0",
			menuName: f.menuName.trim(),
			menuType: f.menuType,
			path: f.path.trim(),
			routeName: f.routeName.trim(),
			component: f.component.trim(),
			perms: f.perms.trim(),
			icon: f.icon.trim(),
			orderNum: f.orderNum.trim(),
			query: f.query.trim(),
			isFrame: f.isFrame,
			isCache: f.isCache,
			status: f.status,
			visible: f.visible,
			remark: ""
		} as MenuPayload
	}

	function goList() {
		uni.redirectTo({
			url: "/pages/system/menu/index",
			fail: (_err) => {
				uni.reLaunch({ url: "/pages/system/menu/index" })
			}
		})
	}

	function doSubmit() {
		if (saving.value) {
			return
		}
		saving.value = true
		const payload = buildPayload()
		const task = isEdit.value ? updateMenu(payload) : addMenu(payload)
		task.then(() => {
			saving.value = false
			uni.showToast({ title: "保存成功", icon: "success", duration: 800 })
			goList()
		}).catch((_e) => {
			saving.value = false
		})
	}

	async function onSave() {
		if (saving.value || loading.value) {
			return
		}
		const ok = await callRiceFormValidate(formRef.value)
		if (ok == true) {
			doSubmit()
			return
		}
		if (ok == null) {
			uni.showToast({ title: "表单未就绪，请稍后重试", icon: "none" })
		}
	}

	function onRemove() {
		if (!isEdit.value || saving.value) {
			return
		}
		const name = form.value.menuName.length > 0 ? form.value.menuName : id.value
		showDialog({
			title: "删除确认",
			message: `确认删除菜单「${name}」？`,
			showCancelButton: true,
			confirmButtonText: "删除",
			confirm: () => {
				saving.value = true
				removeMenu([id.value]).then(() => {
					saving.value = false
					uni.showToast({ title: "已删除", icon: "success", duration: 800 })
					goList()
				}).catch((_e) => {
					saving.value = false
				})
			}
		})
	}
</script>
