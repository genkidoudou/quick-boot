<template>
	<view class="page">
		<view v-if="loading" class="hint"><text class="hint-t">加载中…</text></view>
		<view v-else class="card">
			<text class="title">{{ cred.clientName.length > 0 ? cred.clientName : "客户端凭证" }}</text>
			<text class="label">客户端 ID</text>
			<text class="value">{{ cred.clientId.length > 0 ? cred.clientId : "—" }}</text>
			<text class="label">客户端密钥</text>
			<text class="value">{{ secretMask }}</text>
			<view class="btn" @click="copyId">
				<text class="btn-t">复制 clientId</text>
			</view>
			<view class="btn" @click="copySecret">
				<text class="btn-t">复制 clientSecret</text>
			</view>
			<view class="btn primary" @click="copyBoth">
				<text class="btn-t light">复制全部凭证</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	/**
	 * OAuth 凭证查看（含明文 secret）。
	 */
	import { getOauthClientCredential, OauthCredential } from "@/api/system/oauthClient"

	const loading = ref(false)
	const showPlain = ref(false)
	const cred = ref({
		clientId: "",
		clientName: "",
		clientSecret: ""
	} as OauthCredential)

	const secretMask = computed(() : string => {
		const s = cred.value.clientSecret
		if (s.length == 0) {
			return "—"
		}
		if (showPlain.value) {
			return s
		}
		if (s.length <= 8) {
			return "********"
		}
		return s.substring(0, 4) + "****" + s.substring(s.length - 4)
	})

	function copyText(text : string, label : string) {
		if (text.length == 0) {
			uni.showToast({ title: label + "为空", icon: "none" })
			return
		}
		uni.setClipboardData({
			data: text,
			success: () => {
				uni.showToast({ title: "已复制" + label, icon: "success" })
			}
		})
	}

	function copyId() {
		copyText(cred.value.clientId, "clientId")
	}

	function copySecret() {
		showPlain.value = true
		copyText(cred.value.clientSecret, "clientSecret")
	}

	function copyBoth() {
		const id = cred.value.clientId
		const secret = cred.value.clientSecret
		if (id.length == 0 && secret.length == 0) {
			uni.showToast({ title: "凭证为空", icon: "none" })
			return
		}
		showPlain.value = true
		copyText("clientId=" + id + "\nclientSecret=" + secret, "凭证")
	}

	onLoad((query) => {
		if (query == null) {
			return
		}
		const qid = query["id"]
		if (qid == null || `${qid}`.length == 0) {
			return
		}
		loading.value = true
		getOauthClientCredential(`${qid}`).then((row) => {
			cred.value = row
			loading.value = false
		}).catch((_e) => {
			loading.value = false
			uni.showToast({ title: "加载凭证失败", icon: "none" })
		})
	})
</script>

<style>
	.page {
		display: flex;
		flex-direction: column;
		/* #ifndef APP */
		min-height: 100vh;
		/* #endif */
		/* #ifdef APP */
		flex: 1;
		/* #endif */
		background-color: var(--rice-background);
		padding: 16px;
	}
	.card {
		border-radius: 16px;
		padding: 16px;
		background-color: var(--rice-background-2, #ffffff);
		border-width: 1px;
		border-style: solid;
		border-color: rgba(24, 24, 27, 0.08);
		display: flex;
		flex-direction: column;
	}
	.title {
		font-size: 17px;
		font-weight: 700;
		color: var(--rice-text-color);
		margin-bottom: 12px;
	}
	.label {
		margin-top: 10px;
		font-size: 12px;
		color: #8e8e93;
	}
	.value {
		margin-top: 4px;
		font-size: 14px;
		color: var(--rice-text-color);
		word-break: break-all;
	}
	.btn {
		margin-top: 12px;
		height: 40px;
		border-radius: 10px;
		background-color: rgba(0, 122, 255, 0.12);
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}
	.btn.primary {
		background-color: #007aff;
	}
	.btn-t {
		font-size: 14px;
		font-weight: 600;
		color: #007aff;
	}
	.btn-t.light {
		color: #ffffff;
	}
	.hint {
		padding: 24px;
		align-items: center;
	}
	.hint-t {
		font-size: 13px;
		color: #8e8e93;
	}
</style>
