<template>
	<!-- 登录日志详情：只读，无保存/删除 -->
	<c7-form-page
		:loading="loading"
		:is-edit="true"
		edit-title="登录日志详情"
		:show-save="false"
		:show-delete="false"
	>
		<view class="kv">
			<view class="kv-row">
				<text class="k">用户名</text>
				<text class="v">{{ detail.userName.length > 0 ? detail.userName : "—" }}</text>
			</view>
			<view class="kv-row">
				<text class="k">用户ID</text>
				<text class="v">{{ detail.userId.length > 0 ? detail.userId : "—" }}</text>
			</view>
			<view class="kv-row">
				<text class="k">状态</text>
				<c7-dict-tag :value="detail.status" dict-type="SYS_LOGIN_STATUS"></c7-dict-tag>
			</view>
			<view class="kv-row">
				<text class="k">登录时间</text>
				<text class="v">{{ detail.loginTime.length > 0 ? detail.loginTime : "—" }}</text>
			</view>
			<view class="kv-row">
				<text class="k">IP</text>
				<text class="v">{{ detail.ipAddr.length > 0 ? detail.ipAddr : "—" }}</text>
			</view>
			<view class="kv-row">
				<text class="k">地点</text>
				<text class="v">{{ detail.loginLocation.length > 0 ? detail.loginLocation : "—" }}</text>
			</view>
			<view class="kv-row">
				<text class="k">浏览器</text>
				<text class="v">{{ detail.browser.length > 0 ? detail.browser : "—" }}</text>
			</view>
			<view class="kv-row">
				<text class="k">操作系统</text>
				<text class="v">{{ detail.os.length > 0 ? detail.os : "—" }}</text>
			</view>
			<view class="kv-row">
				<text class="k">客户端</text>
				<text class="v">{{ detail.clientId.length > 0 ? detail.clientId : "—" }}</text>
			</view>
			<view class="kv-row" @click="copyText(detail.traceId, '链路ID')">
				<text class="k">链路ID</text>
				<text class="v link">{{ detail.traceId.length > 0 ? detail.traceId : "—" }}</text>
			</view>
			<view class="kv-row" @click="copyText(detail.ipAddr, 'IP')">
				<text class="k">复制IP</text>
				<text class="v link">点此复制</text>
			</view>
		</view>
	</c7-form-page>
</template>

<script setup lang="uts">
	/**
	 * 登录日志详情（quick-h5）
	 */
	import {
		getLogininfor,
		LogininforPayload
	} from "@/api/system/logininfor"

	const loading = ref(false)
	const detail = ref({
		id: "",
		userName: "",
		userId: "",
		ipAddr: "",
		loginLocation: "",
		browser: "",
		os: "",
		status: "",
		clientId: "",
		traceId: "",
		loginTime: ""
	} as LogininforPayload)

	function loadDetail(id : string) {
		if (id.length == 0 || loading.value) {
			return
		}
		loading.value = true
		getLogininfor(id).then((row) => {
			detail.value = row
			loading.value = false
		}).catch((_e) => {
			loading.value = false
			uni.showToast({ title: "加载详情失败", icon: "none" })
		})
	}

	function copyText(text : string, label : string) {
		if (text.length == 0) {
			uni.showToast({ title: label + "为空", icon: "none" })
			return
		}
		uni.setClipboardData({
			data: text,
			success: () => {
				uni.showToast({ title: "已复制" + label, icon: "success" })
			}
		})
	}

	onLoad((query) => {
		if (query == null) {
			return
		}
		const qid = query["id"]
		if (qid != null && `${qid}`.length > 0) {
			loadDetail(`${qid}`)
		}
	})
</script>

<style>
	.kv {
		display: flex;
		flex-direction: column;
	}
	.kv-row {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		margin-bottom: 12px;
	}
	.k {
		width: 88px;
		font-size: 13px;
		color: #8e8e93;
		padding-top: 2px;
	}
	.v {
		flex: 1;
		font-size: 13px;
		font-weight: 500;
		color: var(--rice-text-color);
	}
	.link {
		color: #007aff;
	}
</style>
