<template>
	<!-- 登录日志列表：仅查询，无新增/删除 -->
	<view class="page">
		<c7-json-table
			ref="tableRef"
			:list-function="pageLogininfor"
			:table-columns="tableColumns"
			:search-columns="searchColumns"
			row-key="id"
			:show-add-button="false"
			:enable-swipe-delete="false"
			:edit-button-permi="['system:logininfor:query']"
			@row-click="onRowClick"
		></c7-json-table>
	</view>
</template>

<script setup lang="uts">
	/**
	 * 登录日志列表（quick-h5）
	 *
	 * 对齐 quick-ui：仅 page / 详情；行点击进 detail。
	 */
	import {
		pageLogininfor,
		LogininforPayload
	} from "@/api/system/logininfor"
	import { bindC7TablePage } from "@/components/c7-json-table/table-page.uts"

	const tableRef = ref<ComponentPublicInstance | null>(null)

	const tableColumns = [
		{
			layout: "row",
			children: [
				{ prop: "userName", hideLabel: true, emphasize: true } as UTSJSONObject,
				{ prop: "status", hideLabel: true, columnType: "tag", dictType: "SYS_LOGIN_STATUS" } as UTSJSONObject
			] as any[]
		} as UTSJSONObject,
		{ prop: "ipAddr", label: "IP", emptyText: "—" } as UTSJSONObject,
		{ prop: "browser", label: "浏览器", emptyText: "—" } as UTSJSONObject,
		{ prop: "os", label: "操作系统", emptyText: "—" } as UTSJSONObject,
		{ prop: "traceId", label: "链路ID", emptyText: "—" } as UTSJSONObject,
		{ prop: "loginTime", label: "登录时间", emptyText: "—" } as UTSJSONObject
	] as any[]

	const searchColumns = [
		{ prop: "userName", label: "用户名", type: "input" } as UTSJSONObject,
		{ prop: "ipAddr", label: "IP", type: "input" } as UTSJSONObject,
		{ prop: "traceId", label: "链路ID", type: "input" } as UTSJSONObject,
		{ prop: "status", label: "状态", type: "select", dictType: "SYS_LOGIN_STATUS" } as UTSJSONObject
	] as any[]

	bindC7TablePage(() : any | null => {
		return tableRef.value
	})

	function onRowClick(row : any) {
		const payload = row as LogininforPayload
		if (payload.id.length == 0) {
			return
		}
		uni.navigateTo({ url: "/pages/system/logininfor/detail?id=" + encodeURIComponent(payload.id) })
	}
</script>

<style>
	.page {
		display: flex;
		flex-direction: column;
		/* #ifndef APP */
		min-height: 100vh;
		/* #endif */
		/* #ifdef APP */
		flex: 1;
		/* #endif */
	}
</style>
