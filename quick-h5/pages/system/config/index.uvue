<template>
	<!-- Soft Glass 列表视觉由 C7JsonTable 内置；本页只配业务 props -->
	<view class="page">
		<c7-json-table
			ref="tableRef"
			:list-function="pageConfig"
			:delete-function="removeConfig"
			:table-columns="tableColumns"
			:search-columns="searchColumns"
			row-key="id"
			:show-add-button="true"
			add-path="/pages/system/config/form"
			edit-path="/pages/system/config/form?id={id}"
			:add-button-permi="['system:config:add']"
			:edit-button-permi="['system:config:edit']"
			:delete-button-permi="['system:config:remove']"
			delete-label-prop="configName"
		></c7-json-table>
	</view>
</template>

<script setup lang="uts">
	/**
	 * 参数管理列表（quick-h5）
	 *
	 * 对齐 quick-ui：pageConfig / tableColumns / searchColumns / removeConfig。
	 * 登录鉴权见全局 permission；列表刷新见 C7JsonTable onShow。
	 * 纯跳转用 add-path / edit-path；复杂交互再用 @add-click / @row-click。
	 */
	import {
		pageConfig,
		removeConfig
	} from "@/api/system/config"
	import { bindC7TablePage } from "@/components/c7-json-table/table-page.uts"

	const tableRef = ref<ComponentPublicInstance | null>(null)

	const tableColumns = [
		{
			layout: "row",
			children: [
				{ prop: "configName", hideLabel: true, emphasize: true } as UTSJSONObject,
				{ prop: "configType", hideLabel: true, columnType: "tag", dictType: "COMMON_IS" } as UTSJSONObject
			] as any[]
		} as UTSJSONObject,
		{ prop: "configKey", label: "参数键名" } as UTSJSONObject,
		{ prop: "configValue", label: "参数值", emptyText: "—" } as UTSJSONObject
	] as any[]

	const searchColumns = [
		{ prop: "configName", label: "参数名称", type: "input" } as UTSJSONObject,
		{ prop: "configKey", label: "参数键名", type: "input" } as UTSJSONObject,
		{ prop: "configType", label: "是否内置", type: "select", dictType: "COMMON_IS" } as UTSJSONObject
	] as any[]

	bindC7TablePage(() : any | null => {
		return tableRef.value
	})
</script>

<style>
	.page {
		display: flex;
		flex-direction: column;
		/* #ifndef APP */
		min-height: 100vh;
		/* #endif */
		/* #ifdef APP */
		flex: 1;
		/* #endif */
	}
</style>
