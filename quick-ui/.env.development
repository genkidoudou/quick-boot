# 开发环境（可提交示例值；生产密钥勿入库）
VITE_APP_TITLE=Quick Boot 管理系统
VITE_APP_LOGIN_TITLE=Quick Boot 后台管理系统
VITE_APP_COPYRIGHT=Copyright © 2024 Quick Boot All Rights Reserved.
VITE_APP_LOADING_TEXT=正在加载系统资源，请耐心等待
VITE_APP_BASE_API=/dev-api
# 积木报表后端根地址（菜单绑定预览；与 qc.jimu.public-base-url 一致）
VITE_JIMU_BASE_URL=http://localhost:9993
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=基于 Spring Boot + Vue 3 的快速开发平台

# Lite RUM（请求链路上报 /monitor/liteTrace/rum/ingest）
VITE_APP_LITE_RUM_ENABLED=true
VITE_APP_LITE_RUM_APP_ID=quick-ui
VITE_APP_LITE_RUM_FLUSH_MS=4000
VITE_APP_LITE_RUM_MAX_BATCH=40
